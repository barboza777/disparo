{
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "framework": "other",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/.*",
      "dest": ".output/server/index.mjs"
    }
  ]
}
